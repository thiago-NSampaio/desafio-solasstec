generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TypePriority {
  id            Int  @id @default(autoincrement())
  description   String
  priorityLevel Int      @map("priority_level")
  active        Boolean
  createdAt     DateTime @default(now()) @map("created_at")

  visitor       Visitor[]

  @@map("types_prioritys")
}

model Visitor {
  id             Int       @id @default(autoincrement())
  name           String
  document       String     @unique
  dateOfBirth    DateTime     @map("date_of_birth")
  photo          String
  active         Boolean
  createdAt      DateTime     @default(now()) @map("created_at")
  priorityLevelId Int

  typePriority   TypePriority @relation(fields: [priorityLevelId], references: [id])
  scheduling Scheduling[]
  entry Entry[]

  @@map("visitors")
}

model Room {
  id Int @id @default(autoincrement())
  name String
  availability Json
  capacity Int
  capacity_variation Int
  active Boolean
  createdAt DateTime @default(now()) @map("created_at")

  scheduling Scheduling[]
  entry Entry[]
  responsibleRoom ResponsibleRoom[]

  @@map("rooms")
}

model Scheduling {
  id Int @id @default(autoincrement())
  visitorId Int
  roomId Int
  dateScheduled Int
  status Boolean
  createdAt DateTime @default(now()) @map("created_at")

  visitor Visitor @relation(fields: [visitorId],references: [id])
  room Room @relation(fields: [roomId],references: [id])

  entry Entry[]

  @@unique([dateScheduled])
  @@map("schedulings")
}

model Entry {
  id Int @id @default(autoincrement())
  visitorId Int
  roomId Int
  schedulingId Int

  visitor Visitor @relation(fields: [visitorId],references: [id])
  room Room @relation(fields: [roomId],references: [id])
  scheduling Scheduling @relation(fields: [schedulingId],references: [id])

  @@map("entrys")
}

model ResponsibleRoom {
  id Int @id @default(autoincrement())
  name String
  roomId Int
  validated DateTime
  validatedAt DateTime @map("validated_at")
  active Boolean
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId],references: [id])

  @@map("responsibles_rooms")
}

model Holiday{
  id Int @id @default(autoincrement())
  date DateTime @unique
  description String
  type Int
  active Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}