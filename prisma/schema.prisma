generator client {
  provider = "prisma-client-js"
  schemas  = ["desafio"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["desafio"]
}

model TypePriority {
  id            String   @id @db.Uuid
  description   String
  priorityLevel Int      @map("priority_level")
  active        Boolean? @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  visitors Visitor[]

  @@map("types_prioritys")
  @@schema("desafio")
}

model Visitor {
  id              String   @id @db.Uuid
  name            String
  document        String   @unique
  dateOfBirth     DateTime @map("date_of_birth") @db.Date
  photo           String?
  active          Boolean? @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  priorityLevelId String?  @db.Uuid

  typePriority TypePriority? @relation(fields: [priorityLevelId], references: [id])
  schedulings  Scheduling[]
  entrys       Entry[]

  @@index([document])
  @@map("visitors")
  @@schema("desafio")
}

model Room {
  id                String   @id @db.Uuid
  name              String
  availability      Json
  capacity          Int
  capacityVariation Int?
  active            Boolean? @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  schedulings       Scheduling[]
  entrys            Entry[]
  responsiblesRooms ResponsibleRoom[]

  @@map("rooms")
  @@schema("desafio")
}

model Scheduling {
  id            String   @id @db.Uuid
  visitorId     String   @db.Uuid
  roomId        String?  @db.Uuid
  dateScheduled DateTime @unique
  status        Int?     @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  entrys  Entry[]

  @@index([dateScheduled])
  @@map("schedulings")
  @@schema("desafio")
}

model Entry {
  id           String    @id @db.Uuid
  visitorId    String    @db.Uuid
  roomId       String?   @db.Uuid
  schedulingId String?   @db.Uuid
  enteredAt    DateTime? @map("entered_at")
  exitedAt     DateTime? @map("exited_at")
  active       Boolean?  @default(true)
  createdAt    DateTime? @default(now()) @map("created_at")

  visitor    Visitor     @relation(fields: [visitorId], references: [id])
  room       Room?       @relation(fields: [roomId], references: [id])
  scheduling Scheduling? @relation(fields: [schedulingId], references: [id])

  @@map("entrys")
  @@schema("desafio")
}

model ResponsibleRoom {
  id        String    @id @db.Uuid
  name      String
  roomId    String?   @db.Uuid
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  active    Boolean?  @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("responsibles_rooms")
  @@schema("desafio")
}

model Holiday {
  id          String   @id @db.Uuid
  date        DateTime @unique @db.Date
  description String
  type        Int?
  active      Boolean? @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("holidays")
  @@schema("desafio")
}
